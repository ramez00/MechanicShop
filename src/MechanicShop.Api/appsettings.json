{
  "ConnectionStrings": {
    "DefaultConnection": "Server = . ; Database = MechanicShopDb ; Trusted_Connection=True; MultipleActiveResultSets = true ; TrustServerCertificate = True;"
  },
  "JwtSettings": {
    "Issuer": "MechanicShop",
    "Audience": "MechanicShopClient",
    "Secret": "MechanicShop-Super-Secret-Signing-Key-Change-Me-32Chars+",
    "TokenExpirationInMinutes": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "Auto",
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@mechanicshop.local",
    "FromName": "MechanicShop",
    "MaxSendAttempts": 3,
    "RetryBaseDelayMilliseconds": 1000,
    "QueueCapacity": 1000
  },
  "AppSettings": {
    "OpeningTime": "08:00",
    "ClosingTime": "18:00",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "BookingLeadTimeMinutes": 60,
    "BookingHorizonDays": 30,
    "CorsPolicyName": "MechanicShop",
    "AllowedOrigins": ["https://localhost:5001", "http://mechanicshop-app"],
    "ClientBaseUrl": "https://localhost:7142"
  },
  "RateLimiting": {
    "Registration": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "ResendConfirmation": {
      "PermitLimit": 3,
      "WindowMinutes": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
