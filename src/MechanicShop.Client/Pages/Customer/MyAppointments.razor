@page "/my-appointments"
@attribute [Authorize(Roles = "Customer")]

<PageTitle>My Appointments</PageTitle>

<h3 class="my-4 border-start border-4 ps-3 fw-semibold text-light">
    <i class="bi bi-journal-check me-2 text-secondary"></i> My Appointments
</h3>

<div class="text-center py-5">
    <i class="bi bi-calendar-event display-1 text-muted"></i>
    <h4 class="text-light mt-3">Coming Soon</h4>
    <p class="text-muted">
        Online appointment booking is currently being developed.
        In the meantime, you can <a href="book-service" class="link-primary">browse our services</a>
        and call us to schedule your appointment.
    </p>
</div>
