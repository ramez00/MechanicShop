<div class="row g-3 mt-1">
    <div class="col-12 col-lg-8">
        <div class="ms-card">
            <div class="ms-card__body">
                <h2 class="fs-6 fw-semibold mb-3">Today's Schedule</h2>
                <p class="text-muted small mb-0">No work orders scheduled yet. Open the customer or work-order sections to get started.</p>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="ms-card">
            <div class="ms-card__body">
                <h2 class="fs-6 fw-semibold mb-3">Quick Actions</h2>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                    <li><a class="btn btn-outline-secondary btn-sm w-100" href="customers">Add a Customer</a></li>
                    <li><a class="btn btn-outline-secondary btn-sm w-100" href="work-orders">Create a Work Order</a></li>
                    <li><a class="btn btn-outline-secondary btn-sm w-100" href="schedule">View the Schedule</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>